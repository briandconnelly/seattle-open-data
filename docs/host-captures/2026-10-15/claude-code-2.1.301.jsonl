{"t": 1792117802.690922, "method": "tools/list", "params": {"method": "tools/list"}, "tools": [{"name": "seattle_data_search_datasets", "title": "Seattle Data Search Datasets", "description": "Find Seattle datasets by topic. Use first when the dataset id is unknown.\n\nResults carry queryability: only `supported` datasets can be described or queried.\nMap and chart views are folded into their parent dataset.\nExample: {\"query\": \"fire 911\"}. Typically 1-3 s.", "inputSchema": {"additionalProperties": false, "properties": {"query": {"maxLength": 200, "minLength": 1, "type": "string", "description": "Words to match; omit to browse."}, "asset_scope": {"enum": ["tabular", "all"], "type": "string", "description": "tabular (default): queryable datasets and filter views. all: adds federated ArcGIS and external links, which cannot be queried."}, "category": {"maxLength": 100, "minLength": 1, "type": "string", "description": "Portal category; omit for all."}, "page_size": {"maximum": 50, "minimum": 1, "type": "integer", "description": "Default 10."}, "cursor": {"minLength": 1, "type": "string", "description": "next_cursor from the previous page; omit for page one."}, "detail": {"enum": ["summary", "full"], "type": "string", "description": "summary (default) or full; changes field density, never row count."}}, "type": "object"}, "outputSchema": {"$defs": {"DatasetSummary": {"additionalProperties": false, "properties": {"dataset_id": {"type": "string"}, "title": {"type": "string"}, "asset_type": {"type": "string"}, "queryability": {"enum": ["supported", "external", "unsupported", "unknown"], "type": "string"}, "portal_url": {"type": "string"}, "updated_at": {"type": "string"}, "guide_uri": {"type": "string"}, "derived_from": {"type": "string"}, "external_url": {"type": "string"}, "category": {"type": "string"}, "description": {"type": "string"}}, "required": ["dataset_id", "title", "asset_type", "queryability", "portal_url"], "type": "object"}, "Source": {"additionalProperties": false, "properties": {"request_id": {"type": "string"}, "now_local": {"type": "string"}, "retrieved_at": {"type": "string"}}, "required": ["request_id", "now_local"], "type": "object"}}, "additionalProperties": true, "properties": {"datasets": {"items": {"$ref": "#/$defs/DatasetSummary"}, "type": "array"}, "has_more": {"type": "boolean"}, "next_cursor": {"type": "string"}, "source": {"$ref": "#/$defs/Source"}}, "required": ["datasets", "has_more", "source"], "type": "object"}, "annotations": {"readOnlyHint": true, "openWorldHint": true}, "_meta": {"fastmcp": {"tags": []}}}, {"name": "seattle_data_describe_dataset", "title": "Seattle Data Describe Dataset", "description": "Decide whether and how to query a dataset: columns, live row count, time coverage,\nplace fields for \"in <area>\" questions (with reliability), and geo columns for `near`.\n\nUse before querying an unfamiliar dataset, and with detail=\"full\" to get place-field values.\nExample: {\"dataset_id\": \"kzjm-xkqj\", \"detail\": \"full\"}.\nTypically 1-3 s; up to about 20 s on very large datasets.", "inputSchema": {"additionalProperties": false, "properties": {"dataset_id": {"description": "Socrata dataset id, e.g. kzjm-xkqj (from seattle_data_search_datasets).", "pattern": "^[a-z0-9]{4}-[a-z0-9]{4}$", "type": "string"}, "column_query": {"maxLength": 100, "minLength": 1, "type": "string", "description": "Only columns whose name or description contains this; omit for all."}, "sample_rows": {"maximum": 5, "minimum": 0, "type": "integer", "description": "Example rows to include. Default 0."}, "detail": {"enum": ["summary", "full"], "type": "string", "description": "summary (default) or full; changes field density, never row count."}}, "required": ["dataset_id"], "type": "object"}, "outputSchema": {"$defs": {"Column": {"additionalProperties": false, "properties": {"name": {"type": "string"}, "type": {"type": "string"}, "description": {"type": "string"}, "stats": {"$ref": "#/$defs/ColumnStats"}}, "required": ["name", "type"], "type": "object"}, "ColumnStats": {"additionalProperties": false, "properties": {"top": {"items": {"type": "string"}, "type": "array"}, "smallest": {"type": "string"}, "largest": {"type": "string"}, "null": {"type": "integer"}, "origin": {"const": "cached_metadata", "default": "cached_metadata", "type": "string"}}, "type": "object"}, "Coverage": {"additionalProperties": false, "properties": {"column": {"type": "string"}, "min": {"type": "string"}, "max": {"type": "string"}, "origin": {"enum": ["live_query", "cached_metadata"], "type": "string"}, "status": {"default": "ok", "enum": ["ok", "timeout", "unavailable"], "type": "string"}}, "required": ["column"], "type": "object"}, "ExampleQuery": {"additionalProperties": false, "properties": {"question": {"type": "string"}, "arguments": {"additionalProperties": true, "type": "object"}}, "required": ["question", "arguments"], "type": "object"}, "GeoColumn": {"additionalProperties": false, "properties": {"column": {"type": "string"}, "type": {"type": "string"}}, "required": ["column", "type"], "type": "object"}, "GeoUnusable": {"additionalProperties": false, "properties": {"column": {"type": "string"}, "reason": {"type": "string"}}, "required": ["column", "reason"], "type": "object"}, "PlaceField": {"additionalProperties": false, "properties": {"column": {"type": "string"}, "kind": {"enum": ["neighborhood", "precinct", "sector", "beat", "zip", "council_district", "census_tract"], "type": "string"}, "source": {"enum": ["column", "computed_region"], "type": "string"}, "reliability": {"enum": ["ok", "partial", "unreliable"], "type": "string"}, "reliability_reason": {"type": "string"}, "values": {"items": {"$ref": "#/$defs/PlaceValue"}, "type": "array"}, "placeholder_values": {"items": {"$ref": "#/$defs/PlaceholderValue"}, "type": "array"}, "assigned_fraction": {"type": "number"}, "layer_id": {"type": "string"}, "label_column": {"type": "string"}, "boundary_vintage": {"type": "string"}, "stats_status": {"enum": ["ok", "timeout"], "type": "string"}}, "required": ["column", "kind", "source", "reliability"], "type": "object"}, "PlaceValue": {"additionalProperties": false, "properties": {"label": {"type": "string"}, "value": {"type": "string"}}, "required": ["label", "value"], "type": "object"}, "PlaceholderValue": {"additionalProperties": false, "properties": {"value": {"type": "string"}, "rows": {"type": "integer"}}, "required": ["value", "rows"], "type": "object"}, "RowCount": {"additionalProperties": false, "properties": {"value": {"type": "integer"}, "origin": {"enum": ["live_query", "cached_metadata"], "type": "string"}, "status": {"default": "ok", "enum": ["ok", "timeout", "unavailable"], "type": "string"}}, "type": "object"}, "Source": {"additionalProperties": false, "properties": {"request_id": {"type": "string"}, "now_local": {"type": "string"}, "retrieved_at": {"type": "string"}}, "required": ["request_id", "now_local"], "type": "object"}, "TimeSemantics": {"additionalProperties": false, "properties": {"column": {"type": "string"}, "type": {"type": "string"}, "timezone": {"type": "string"}, "evidence": {"type": "string"}}, "required": ["column", "type"], "type": "object"}}, "additionalProperties": true, "properties": {"dataset_id": {"type": "string"}, "title": {"type": "string"}, "queryability": {"enum": ["supported", "external", "unsupported", "unknown"], "type": "string"}, "row_count": {"$ref": "#/$defs/RowCount"}, "data_coverage": {"items": {"$ref": "#/$defs/Coverage"}, "type": "array"}, "columns": {"items": {"$ref": "#/$defs/Column"}, "type": "array"}, "stats_available": {"type": "boolean"}, "place_fields": {"items": {"$ref": "#/$defs/PlaceField"}, "type": "array"}, "geo_columns": {"items": {"$ref": "#/$defs/GeoColumn"}, "type": "array"}, "geo_unusable": {"items": {"$ref": "#/$defs/GeoUnusable"}, "type": "array"}, "time_semantics": {"items": {"$ref": "#/$defs/TimeSemantics"}, "type": "array"}, "guide_uri": {"type": "string"}, "example_queries": {"items": {"$ref": "#/$defs/ExampleQuery"}, "type": "array"}, "sample_rows": {"items": {"additionalProperties": true, "type": "object"}, "type": "array"}, "source": {"$ref": "#/$defs/Source"}}, "required": ["dataset_id", "title", "queryability", "row_count", "data_coverage", "columns", "stats_available", "place_fields", "geo_columns", "time_semantics", "source"], "type": "object"}, "annotations": {"readOnlyHint": true, "openWorldHint": true}, "_meta": {"fastmcp": {"tags": []}}}, {"name": "seattle_data_query_dataset", "title": "Seattle Data Query Dataset", "description": "Run a bounded read or aggregate on one dataset.\n\nPrefer aggregates (count, group_by) on large datasets. Area filters are ordinary\n`where` predicates on place fields from seattle_data_describe_dataset.\nWith cursor, send only dataset_id, cursor, and optionally page_size or detail.\nExample: {\"dataset_id\": \"kzjm-xkqj\", \"select\": [\"type\", \"count(*) AS n\"],\n\"group_by\": [\"type\"], \"order_by\": [\"n DESC\"]}.\nTypically 1-5 s; fails with query_timeout after 30 s.", "inputSchema": {"$defs": {"Near": {"additionalProperties": false, "properties": {"column": {"description": "A column listed in describe's geo_columns.", "minLength": 1, "type": "string"}, "latitude": {"maximum": 90, "minimum": -90, "type": "number"}, "longitude": {"maximum": 180, "minimum": -180, "type": "number"}, "radius_m": {"description": "Radius in meters.", "exclusiveMinimum": 0, "maximum": 50000, "type": "number"}}, "required": ["column", "latitude", "longitude", "radius_m"], "type": "object"}}, "additionalProperties": false, "properties": {"dataset_id": {"description": "Socrata dataset id, e.g. kzjm-xkqj (from seattle_data_search_datasets).", "pattern": "^[a-z0-9]{4}-[a-z0-9]{4}$", "type": "string"}, "mode": {"enum": ["clauses", "soql"], "type": "string", "description": "clauses (default): paged query built from the clause arguments. soql: run `soql` verbatim, one page."}, "select": {"items": {"maxLength": 4096, "minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "description": "Columns or expressions, e.g. [\"type\", \"count(*) AS n\"]. Omit for all data columns."}, "where": {"maxLength": 4096, "minLength": 1, "type": "string", "description": "SoQL predicate."}, "group_by": {"items": {"maxLength": 4096, "minLength": 1, "type": "string"}, "minItems": 1, "type": "array"}, "having": {"maxLength": 4096, "minLength": 1, "type": "string"}, "order_by": {"items": {"maxLength": 4096, "minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "description": "e.g. [\"n DESC\"]."}, "search_text": {"maxLength": 200, "minLength": 1, "type": "string", "description": "Full-text search across text columns."}, "near": {"$ref": "#/$defs/Near", "description": "Rows within radius_m meters of a point."}, "soql": {"maxLength": 4096, "minLength": 1, "type": "string", "description": "Full SoQL statement; requires mode='soql'."}, "page_size": {"maximum": 500, "minimum": 1, "type": "integer", "description": "Rows per page. Default 100."}, "cursor": {"minLength": 1, "type": "string", "description": "next_cursor from the previous page; omit for page one."}, "detail": {"enum": ["summary", "full"], "type": "string", "description": "summary (default) or full; changes field density, never row count."}}, "required": ["dataset_id"], "type": "object"}, "outputSchema": {"$defs": {"CoverageWarning": {"additionalProperties": false, "properties": {"column": {"type": "string"}, "reliability": {"enum": ["ok", "partial", "unreliable"], "type": "string"}, "reason": {"type": "string"}, "assigned_fraction": {"type": "number"}}, "required": ["column", "reliability", "reason"], "type": "object"}, "ResultColumn": {"additionalProperties": false, "properties": {"name": {"type": "string"}, "type": {"type": "string"}}, "required": ["name", "type"], "type": "object"}, "Source": {"additionalProperties": false, "properties": {"request_id": {"type": "string"}, "now_local": {"type": "string"}, "retrieved_at": {"type": "string"}}, "required": ["request_id", "now_local"], "type": "object"}}, "additionalProperties": true, "properties": {"dataset_id": {"type": "string"}, "columns": {"items": {"$ref": "#/$defs/ResultColumn"}, "type": "array"}, "rows": {"items": {"additionalProperties": true, "type": "object"}, "type": "array"}, "returned_rows": {"type": "integer"}, "has_more": {"type": "boolean"}, "next_cursor": {"type": "string"}, "truncated": {"type": "boolean"}, "truncation_reason": {"type": "string"}, "truncation_hint": {"type": "string"}, "consistency": {"enum": ["stable", "best_effort", "single_page"], "type": "string"}, "coverage_warnings": {"items": {"$ref": "#/$defs/CoverageWarning"}, "type": "array"}, "query_url": {"type": "string"}, "query_url_omitted": {"type": "boolean"}, "download_url": {"type": "string"}, "download_url_omitted": {"type": "boolean"}, "effective_query": {"type": "string"}, "source": {"$ref": "#/$defs/Source"}}, "required": ["dataset_id", "columns", "rows", "returned_rows", "has_more", "truncated", "consistency", "source"], "type": "object"}, "annotations": {"readOnlyHint": true, "openWorldHint": true}, "_meta": {"fastmcp": {"tags": []}}}, {"name": "seattle_data_get_reference", "title": "Seattle Data Get Reference", "description": "Read the server's reference: capability summary, SoQL help, dataset guides, and the\nfull error catalog. Call with no arguments for the index.\n\nExample: {\"topic\": \"soql\", \"item_id\": \"dates\"}.", "inputSchema": {"additionalProperties": false, "properties": {"topic": {"enum": ["index", "capabilities", "guides", "soql", "errors"], "type": "string", "description": "Default index."}, "item_id": {"maxLength": 64, "minLength": 1, "type": "string", "description": "An item from the topic's entries; omit for the topic index."}, "chunk_id": {"maxLength": 64, "minLength": 1, "type": "string", "description": "Requires item_id."}, "detail": {"enum": ["summary", "full"], "type": "string", "description": "summary (default) or full; changes field density, never row count."}}, "type": "object"}, "outputSchema": {"$defs": {"ReferenceEntry": {"additionalProperties": false, "properties": {"item_id": {"type": "string"}, "title": {"type": "string"}, "description": {"type": "string"}, "uri": {"type": "string"}}, "required": ["item_id", "title", "description", "uri"], "type": "object"}, "Source": {"additionalProperties": false, "properties": {"request_id": {"type": "string"}, "now_local": {"type": "string"}, "retrieved_at": {"type": "string"}}, "required": ["request_id", "now_local"], "type": "object"}}, "additionalProperties": true, "properties": {"topic": {"type": "string"}, "uri": {"type": "string"}, "title": {"type": "string"}, "summary": {"type": "string"}, "version": {"type": "string"}, "entries": {"items": {"$ref": "#/$defs/ReferenceEntry"}, "type": "array"}, "body": {"type": "string"}, "chunk_id": {"type": "string"}, "next_chunk_id": {"type": "string"}, "source": {"$ref": "#/$defs/Source"}}, "required": ["topic", "uri", "title", "summary", "version", "source"], "type": "object"}, "annotations": {"readOnlyHint": true, "openWorldHint": false}, "_meta": {"fastmcp": {"tags": []}}}]}
{"t": 1792117808.4159539, "method": "tools/call", "params": {"name": "seattle_data_get_reference", "arguments": {"topic": "soql", "item_id": "dates"}}}
