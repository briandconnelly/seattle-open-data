    {
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      },
      "annotations": {
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Run a bounded read or aggregate on one dataset.\n\nPrefer aggregates (count, group_by) on large datasets. Area filters are ordinary\n`where` predicates on place fields from seattle_data_describe_dataset.\nWithout order_by, rows come in a stable but arbitrary order.\nWith cursor, send only dataset_id, cursor, and optionally page_size or detail.\nExample: {\"dataset_id\": \"kzjm-xkqj\", \"select\": [\"type\", \"count(*) AS n\"],\n\"group_by\": [\"type\"], \"order_by\": [\"n DESC\"]}.\nTypically 1-5 s; fails with query_timeout after 30 s.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "description": "next_cursor from the previous page; omit for page one.",
            "minLength": 1,
            "type": "string"
          },
          "dataset_id": {
            "description": "Socrata dataset id, e.g. kzjm-xkqj (from seattle_data_search_datasets).",
            "pattern": "^[a-z0-9]{4}-[a-z0-9]{4}$",
            "type": "string"
          },
          "detail": {
            "description": "summary (default) or full; changes field density, never row count.",
            "enum": [
              "summary",
              "full"
            ],
            "type": "string"
          },
          "group_by": {
            "items": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "having": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "mode": {
            "description": "clauses (default): paged query built from the clause arguments. soql: run `soql` verbatim, one page.",
            "enum": [
              "clauses",
              "soql"
            ],
            "type": "string"
          },
          "near": {
            "additionalProperties": false,
            "description": "Rows within radius_m meters of a point.",
            "properties": {
              "column": {
                "description": "A column listed in describe's geo_columns.",
                "minLength": 1,
                "type": "string"
              },
              "latitude": {
                "maximum": 90,
                "minimum": -90,
                "type": "number"
              },
              "longitude": {
                "maximum": 180,
                "minimum": -180,
                "type": "number"
              },
              "radius_m": {
                "description": "Radius in meters.",
                "exclusiveMinimum": 0,
                "maximum": 50000,
                "type": "number"
              }
            },
            "required": [
              "column",
              "latitude",
              "longitude",
              "radius_m"
            ],
            "type": "object"
          },
          "order_by": {
            "description": "e.g. [\"n DESC\"].",
            "items": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "page_size": {
            "description": "Rows per page. Default 100; a continuation keeps the first page's size.",
            "maximum": 500,
            "minimum": 1,
            "type": "integer"
          },
          "search_text": {
            "description": "Full-text search across text columns.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "select": {
            "description": "Columns or expressions, e.g. [\"type\", \"count(*) AS n\"]. Omit for all data columns.",
            "items": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "soql": {
            "description": "Full SoQL statement; requires mode='soql'.",
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "where": {
            "description": "SoQL predicate.",
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "dataset_id"
        ],
        "type": "object"
      },
      "name": "seattle_data_query_dataset",
      "outputSchema": {
        "additionalProperties": true,
        "properties": {
          "columns": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "type"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "consistency": {
            "enum": [
              "stable",
              "best_effort",
              "single_page"
            ],
            "type": "string"
          },
          "coverage_warnings": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "assigned_fraction": {
                  "type": "number"
                },
                "column": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "reliability": {
                  "enum": [
                    "ok",
                    "partial",
                    "unreliable"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "column",
                "reliability",
                "reason"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "dataset_id": {
            "type": "string"
          },
          "download_url": {
            "type": "string"
          },
          "download_url_omitted": {
            "type": "boolean"
          },
          "effective_query": {
            "type": "string"
          },
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": "string"
          },
          "query_url": {
            "type": "string"
          },
          "query_url_omitted": {
            "type": "boolean"
          },
          "returned_rows": {
            "type": "integer"
          },
          "rows": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array"
          },
          "source": {
            "additionalProperties": false,
            "properties": {
              "now_local": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              },
              "retrieved_at": {
                "type": "string"
              }
            },
            "required": [
              "request_id",
              "now_local"
            ],
            "type": "object"
          },
          "truncated": {
            "type": "boolean"
          },
          "truncation_hint": {
            "type": "string"
          },
          "truncation_reason": {
            "type": "string"
          }
        },
        "required": [
          "dataset_id",
          "columns",
          "rows",
          "returned_rows",
          "has_more",
          "truncated",
          "consistency",
          "source"
        ],
        "type": "object"
      },
      "title": "Seattle Data Query Dataset"
    },
