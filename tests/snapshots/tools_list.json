      "annotations": {
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Find Seattle datasets by topic. Use first when the dataset id is unknown.\n\nResults carry queryability: only `supported` datasets can be described or queried.\nMap and chart views are folded into their parent dataset.\nExample: {\"query\": \"fire 911\"}. Typically 1-3 s.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "asset_scope": {
            "description": "tabular (default): queryable datasets and filter views. all: adds federated ArcGIS and external links, which cannot be queried.",
            "enum": [
              "tabular",
              "all"
            ],
            "type": "string"
          },
          "category": {
            "description": "Portal category; omit for all.",
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "cursor": {
            "description": "next_cursor from the previous page; omit for page one.",
            "minLength": 1,
            "type": "string"
          },
          "detail": {
            "description": "summary (default) or full; changes field density, never row count.",
            "enum": [
              "summary",
              "full"
            ],
            "type": "string"
          },
          "page_size": {
            "description": "Default 10.",
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "query": {
            "description": "Words to match; omit to browse.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "seattle_data_search_datasets",
      "outputSchema": {
        "additionalProperties": true,
        "properties": {
          "datasets": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "asset_type": {
                  "type": "string"
                },
                "category": {
                  "type": "string"
                },
                "dataset_id": {
                  "type": "string"
                },
                "derived_from": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "external_url": {
                  "type": "string"
                },
                "guide_uri": {
                  "type": "string"
                },
                "portal_url": {
                  "type": "string"
                },
                "queryability": {
                  "enum": [
                    "supported",
                    "external",
                    "unsupported",
                    "unknown"
                  ],
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "updated_at": {
                  "type": "string"
                }
              },
              "required": [
                "dataset_id",
                "title",
                "asset_type",
                "queryability",
                "portal_url"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": "string"
          },
          "source": {
            "additionalProperties": false,
            "properties": {
              "now_local": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              },
              "retrieved_at": {
                "type": "string"
              }
            },
            "required": [
              "request_id",
              "now_local"
            ],
            "type": "object"
          }
        },
        "required": [
          "datasets",
          "has_more",
          "source"
        ],
        "type": "object"
      },
      "title": "Seattle Data Search Datasets"
