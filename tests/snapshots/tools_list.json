      "annotations": {
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Decide whether and how to query a dataset: columns, live row count, time coverage,\nplace fields for \"in <area>\" questions (with reliability), and geo columns for `near`.\n\nUse before querying an unfamiliar dataset, and with detail=\"full\" to get place-field values.\nExample: {\"dataset_id\": \"kzjm-xkqj\", \"detail\": \"full\"}.\nTypically 1-3 s; up to about 20 s on very large datasets.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "column_query": {
            "description": "Only columns whose name or description contains this; omit for all.",
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "dataset_id": {
            "description": "Socrata dataset id, e.g. kzjm-xkqj (from seattle_data_search_datasets).",
            "pattern": "^[a-z0-9]{4}-[a-z0-9]{4}$",
            "type": "string"
          },
          "detail": {
            "description": "summary (default) or full; changes field density, never row count.",
            "enum": [
              "summary",
              "full"
            ],
            "type": "string"
          },
          "sample_rows": {
            "description": "Example rows to include. Default 0.",
            "maximum": 5,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "dataset_id"
        ],
        "type": "object"
      },
